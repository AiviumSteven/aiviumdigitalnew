---
interface Props {
  title: string;
  description: string;
  canonical: string; // path, e.g. "/" or "/ai-seo/"
  ogTitle?: string;
  ogDescription?: string;
  /** Path or built-asset URL; defaults to the sitewide OG image. */
  ogImage?: string;
  /** Set on blog posts: switches og:type to article + emits article: metas. */
  article?: { publishedTime: string; modifiedTime?: string | null };
  noindex?: boolean;
  styles?: string[]; // extra stylesheets inlined after main.css
  bodyClass?: string;
}

const {
  title,
  description,
  canonical,
  ogTitle = title,
  ogDescription = description,
  ogImage = "/assets/og-image.jpg",
  article,
  noindex = false,
  styles = [],
  bodyClass,
} = Astro.props;

const site = "https://aiviumdigital.com";
const url = site + canonical;
const ogImageUrl = new URL(ogImage, site).href;

/* All CSS is inlined into one <style> at build time: on a throttled mobile
   connection every render-blocking stylesheet request costs a full round
   trip before first paint. fonts.css uses URLs relative to /styles/, which
   would resolve against the page URL once inlined, so they become absolute. */
const cssSources = import.meta.glob("../../public/styles/*.css", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;
const readCss = (path: string) => {
  const raw = cssSources[`../../public${path}`];
  if (raw === undefined) throw new Error(`BaseLayout: unknown stylesheet ${path}`);
  return raw.replace(/url\(\.\.\//g, "url(/");
};
const inlineCss = ["/styles/fonts.css", "/styles/tokens.css", "/styles/main.css", ...styles]
  .map(readCss)
  .join("\n");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={article ? "article" : "website"} />
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    <meta property="og:site_name" content="Aivium Digital" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link
      rel="preload"
      href="/assets/fonts/archivo-k3kQo8UDI-1M0wlSfdnoLg.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/plexmono--F6qfjptAgt5VM-kVkqdyU8n3twJwlBFgg.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:inline set:html={inlineCss}></style>

    <script is:inline src="/js/analytics.js" defer></script>

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <div class="grain" aria-hidden="true"></div>
    <slot name="scripts" />
  </body>
</html>
