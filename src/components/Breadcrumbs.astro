---
/**
 * Visible breadcrumb trail. Pages that render this also add
 * breadcrumbNode(trail) to their JSON-LD graph with the same pairs,
 * so the visible hierarchy and BreadcrumbList always match.
 */
interface Props {
  /** [label, path] pairs, Home first. The last item is the current page. */
  trail: [string, string][];
}
const { trail } = Astro.props;
const last = trail.length - 1;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {
      trail.map(([label, path], i) => (
        <li>
          {i === last ? (
            <span aria-current="page">{label}</span>
          ) : (
            <a href={path}>{label}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs {
    margin-bottom: var(--space-6);
  }
  .crumbs ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .crumbs li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .crumbs li + li::before {
    content: "/";
    color: var(--cream-55);
    opacity: 0.6;
  }
  .crumbs a {
    color: var(--cream-55);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--cream);
  }
  .crumbs span[aria-current] {
    color: var(--cream-72);
  }
</style>
