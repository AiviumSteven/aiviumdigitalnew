---
interface Props {
  /** which primary link gets aria-current */
  active?: "visibility" | "solutions" | "signals";
  /** on the homepage, anchor links stay local so scroll-spy works */
  home?: boolean;
}
const { active, home = false } = Astro.props;
const processHref = home ? "#process" : "/#process";
---

<header class="nav" data-nav>
  <div class="container nav__inner">
    <a class="nav__logo" href="/" aria-label="Aivium Digital home">
      <img src="/assets/aivium-digital-lockup-horizontal-dark.svg" alt="Aivium Digital" />
    </a>
    <nav class="nav__primary" aria-label="Primary">
      <ul class="nav__links">
        <li><a href="/ai-seo/" aria-current={active === "visibility" ? "true" : undefined}>AI Visibility</a></li>
        <li><a href="/ai-automation/" aria-current={active === "solutions" ? "true" : undefined}>AI Solutions</a></li>
        <li><a href={processHref}>Process</a></li>
        <li><a href="/signals/" aria-current={active === "signals" ? "true" : undefined}>Signals</a></li>
        <li><a href="#faq">FAQ</a></li>
      </ul>
    </nav>
    <div class="nav__actions">
      <a class="nav__phone" href="tel:+12407304333">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>240-730-4333</span>
      </a>
      <a class="btn btn--primary nav__cta" href="/discovery/">Book a free Discovery</a>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-overlay">
        <span class="visually-hidden">Menu</span>
        <span class="nav__toggle-line" aria-hidden="true"></span>
        <span class="nav__toggle-line" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="nav__overlay" id="nav-overlay" inert>
    <nav aria-label="Primary, mobile">
      <ul class="nav__overlay-links">
        <li><a href="/ai-seo/"><span class="nav__overlay-index">01</span>AI Visibility</a></li>
        <li><a href="/ai-automation/"><span class="nav__overlay-index">02</span>AI Solutions</a></li>
        <li><a href={processHref}><span class="nav__overlay-index">03</span>Process</a></li>
        <li><a href="/signals/"><span class="nav__overlay-index">04</span>Signals</a></li>
        <li><a href="#faq"><span class="nav__overlay-index">05</span>FAQ</a></li>
      </ul>
    </nav>
    <div class="nav__overlay-footer">
      <a class="nav__overlay-phone" href="tel:+12407304333">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>240-730-4333</span>
      </a>
      <a class="btn btn--primary" href="/discovery/">Book a free Discovery</a>
    </div>
  </div>
</header>

{/* Nav behavior (scrolled glass bar, mobile overlay, scroll-spy) ships
    with the component so every page that renders a nav gets it. */}
<script is:inline src="/js/nav.js"></script>
