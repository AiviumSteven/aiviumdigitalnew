---
import { COMPANY } from "../data/company";

interface Props {
  /** which primary link gets aria-current */
  active?: "visibility" | "solutions" | "services" | "process" | "signals" | "about";
  /** kept for call-site compatibility; the nav no longer uses homepage anchors */
  home?: boolean;
}
const { active } = Astro.props;

const links = [
  { href: "/ai-seo/", label: "AI Visibility", key: "visibility" },
  { href: "/ai-automation/", label: "AI Solutions", key: "solutions" },
  { href: "/services/", label: "Services", key: "services" },
  { href: "/process/", label: "Process", key: "process" },
  { href: "/signals/", label: "Signals", key: "signals" },
  { href: "/about/", label: "About", key: "about" },
] as const;
---

<header class="nav" data-nav>
  <div class="container nav__inner">
    <a class="nav__logo" href="/" aria-label="Aivium Digital home">
      <img src={COMPANY.logoPath} alt="Aivium Digital" />
    </a>
    <nav class="nav__primary" aria-label="Primary">
      <ul class="nav__links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={active === l.key ? "true" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="nav__actions">
      <a class="nav__phone" href={`tel:${COMPANY.phoneE164}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>{COMPANY.phoneDisplay}</span>
      </a>
      <a class="btn btn--primary nav__cta" href="/discovery/">Book a discovery call</a>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-overlay">
        <span class="visually-hidden">Menu</span>
        <span class="nav__toggle-line" aria-hidden="true"></span>
        <span class="nav__toggle-line" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="nav__overlay" id="nav-overlay" inert>
    <nav aria-label="Primary, mobile">
      <ul class="nav__overlay-links">
        {
          links.map((l, i) => (
            <li>
              <a href={l.href}>
                <span class="nav__overlay-index">{String(i + 1).padStart(2, "0")}</span>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="nav__overlay-footer">
      <a class="nav__overlay-phone" href={`tel:${COMPANY.phoneE164}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>{COMPANY.phoneDisplay}</span>
      </a>
      <a class="btn btn--primary" href="/discovery/">Book a discovery call</a>
    </div>
  </div>
</header>

{/* Nav behavior (scrolled glass bar, mobile overlay, scroll-spy) ships
    with the component so every page that renders a nav gets it. */}
<script is:inline src="/js/nav.js" defer></script>
