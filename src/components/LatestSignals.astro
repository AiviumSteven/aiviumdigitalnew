---
import { Image } from "astro:assets";
import { getSignals } from "../lib/signals";

/*
 * Latest AI Signals — homepage teaser for the three newest posts.
 * Cards lead with the post's hero image (processed by astro:assets);
 * posts without one get the radar-motif fallback panel so the grid
 * never collapses to bare text. Renders nothing while the blog is empty.
 */
const posts = (await getSignals()).slice(0, 3);

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
---

{
  posts.length > 0 && (
    <section class="signals-latest" aria-labelledby="signals-latest-heading" data-latest-signals>
      <div class="container">
        <div class="signals-latest__head">
          <div>
            <h2 id="signals-latest-heading">Latest AI Signals</h2>
            <p class="lede signals-latest__lede">
              The latest AI Signals from industry experts to help you navigate
              this exciting new landscape.
            </p>
          </div>
          <a class="signals-latest__all" href="/signals/">All signals →</a>
        </div>
        <div class="signals-latest__grid">
          {posts.map((p) => (
            <a class="signals-latest__card" href={`/signals/${p.id}/`}>
              <div class="signals-latest__media">
                {p.data.image ? (
                  <Image
                    src={p.data.image}
                    alt=""
                    widths={[420, 640, 840]}
                    sizes="(max-width: 720px) 100vw, 400px"
                  />
                ) : (
                  <div class="signals-latest__fallback" aria-hidden="true">
                    <svg viewBox="0 0 400 225" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="290" cy="112" r="40" stroke="rgba(246,242,234,0.13)" />
                      <circle cx="290" cy="112" r="78" stroke="rgba(246,242,234,0.08)" stroke-dasharray="2 7" />
                      <circle cx="290" cy="112" r="118" stroke="rgba(246,242,234,0.05)" />
                      <line x1="290" y1="112" x2="360" y2="60" stroke="#e5391b" stroke-opacity="0.5" stroke-width="1.5" />
                      <circle cx="290" cy="112" r="2.5" fill="rgba(246,242,234,0.55)" />
                      <circle cx="360" cy="60" r="3.5" fill="#e5391b" />
                      <text x="28" y="196" font-family="IBM Plex Mono, monospace" font-size="13" letter-spacing="3" fill="rgba(246,242,234,0.32)">SIGNAL</text>
                    </svg>
                  </div>
                )}
              </div>
              <time datetime={p.data.publishedAt.toISOString()} class="signals-latest__date">
                {fmtDate(p.data.publishedAt)}
              </time>
              <h3 class="signals-latest__title">{p.data.title}</h3>
              <span class="signals-latest__read">Read the signal</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .signals-latest {
    padding: var(--space-section) 0;
    border-top: 1px solid var(--line);
  }
  .signals-latest__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }
  .signals-latest__lede {
    margin-top: var(--space-4);
    max-width: 34rem;
  }
  .signals-latest__all {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--cream-55);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .signals-latest__all:hover {
    color: var(--cream);
  }
  .signals-latest__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }
  @media (max-width: 900px) {
    .signals-latest__grid {
      grid-template-columns: 1fr;
    }
    .signals-latest__head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
  }
  .signals-latest__card {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--line);
    background: var(--void-850);
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .signals-latest__card:hover {
    border-color: rgba(229, 57, 27, 0.45);
    transform: translateY(-3px);
  }
  .signals-latest__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: var(--void-900);
  }
  .signals-latest__media :global(img),
  .signals-latest__fallback svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease, opacity 0.4s ease;
    opacity: 0.92;
  }
  .signals-latest__card:hover .signals-latest__media :global(img),
  .signals-latest__card:hover .signals-latest__fallback svg {
    transform: scale(1.03);
    opacity: 1;
  }
  .signals-latest__fallback {
    width: 100%;
    height: 100%;
  }
  .signals-latest__date {
    display: block;
    margin: var(--space-6) var(--space-6) 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--cream-55);
  }
  .signals-latest__title {
    margin: var(--space-3) var(--space-6) 0;
    font-size: 1.1875rem;
    line-height: 1.35;
    color: var(--cream);
    transition: color 0.2s ease;
  }
  .signals-latest__card:hover .signals-latest__title {
    color: var(--accent);
  }
  .signals-latest__read {
    display: inline-block;
    margin: var(--space-4) var(--space-6) var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--cream-32);
    transition: color 0.2s ease;
  }
  .signals-latest__card:hover .signals-latest__read {
    color: var(--cream-72);
  }
</style>
