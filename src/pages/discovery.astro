---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Aivium Digital | Book a Free Discovery"
  description="Answer nine quick questions about your growth goals and book a free discovery call with Aivium Digital."
  canonical="/discovery/"
  noindex={true}
  styles={["/styles/quiz.css"]}
  bodyClass="quiz-page"
>


  <header class="quiz-nav">
    <div class="container quiz-nav__inner">
      <a class="quiz-nav__logo" href="/" aria-label="Aivium Digital home">
        <img src="/assets/aivium-digital-lockup-horizontal-dark.svg" alt="Aivium Digital" />
      </a>
      <a class="nav__phone" href="tel:+12407304333">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>240-730-4333</span>
      </a>
    </div>
  </header>

  <div class="quiz-progress" data-progress>
    <div class="container quiz-progress__inner">
      <p class="quiz-progress__count" aria-live="polite">
        Question <strong data-progress-current>1</strong> / <span data-progress-total>10</span>
      </p>
      <div class="quiz-progress__track" aria-hidden="true">
        <div class="quiz-progress__fill" data-progress-fill></div>
      </div>
    </div>
  </div>

  <main class="quiz-main">
    <div class="container">
      <form class="quiz-stage" id="quiz" novalidate>

        <section class="quiz-step" data-step="1">
          <h1 class="quiz-step__question">What is your most important growth outcome?</h1>
          <fieldset>
            <legend class="visually-hidden">What is your most important growth outcome?</legend>
            <div class="quiz-options" data-question="growth_outcome"></div>
          </fieldset>
        </section>

        <section class="quiz-step" data-step="2">
          <h2 class="quiz-step__question">How do most new customers currently find you?</h2>
          <fieldset>
            <legend class="visually-hidden">How do most new customers currently find you?</legend>
            <div class="quiz-options" data-question="customer_source"></div>
          </fieldset>
        </section>

        <section class="quiz-step" data-step="3">
          <h2 class="quiz-step__question">Which statement best describes the current problem?</h2>
          <fieldset>
            <legend class="visually-hidden">Which statement best describes the current problem?</legend>
            <div class="quiz-options" data-question="current_problem"></div>
          </fieldset>
        </section>

        <section class="quiz-step" data-step="4">
          <h2 class="quiz-step__question">How quickly are new inquiries normally contacted?</h2>
          <fieldset>
            <legend class="visually-hidden">How quickly are new inquiries normally contacted?</legend>
            <div class="quiz-options" data-question="response_speed"></div>
          </fieldset>
        </section>

        <section class="quiz-step" data-step="5">
          <h2 class="quiz-step__question">What is your approximate annual revenue?</h2>
          <fieldset>
            <legend class="visually-hidden">What is your approximate annual revenue?</legend>
            <div class="quiz-options" data-question="annual_revenue"></div>
          </fieldset>
        </section>

        <section class="quiz-step" data-step="6">
          <h2 class="quiz-step__question">What does your current monthly marketing investment look like?</h2>
          <fieldset>
            <legend class="visually-hidden">What does your current monthly marketing investment look like?</legend>
            <div class="quiz-options" data-question="marketing_budget"></div>
          </fieldset>
        </section>

        <section class="quiz-step" data-step="7">
          <h2 class="quiz-step__question">How many locations or meaningful service territories do you operate?</h2>
          <fieldset>
            <legend class="visually-hidden">How many locations or meaningful service territories do you operate?</legend>
            <div class="quiz-options" data-question="locations"></div>
          </fieldset>
        </section>

        <section class="quiz-step" data-step="8">
          <h2 class="quiz-step__question">When do you want to improve this?</h2>
          <fieldset>
            <legend class="visually-hidden">When do you want to improve this?</legend>
            <div class="quiz-options" data-question="timeline"></div>
          </fieldset>
        </section>

        <section class="quiz-step" data-step="9">
          <h2 class="quiz-step__question">What is your role?</h2>
          <fieldset>
            <legend class="visually-hidden">What is your role?</legend>
            <div class="quiz-options" data-question="role"></div>
          </fieldset>
        </section>

        <section class="quiz-step" data-step="10">
          <h2 class="quiz-step__question">Where should we send your discovery prep?</h2>
          <p class="quiz-step__hint">
            Last step. We review your answers before the call so the
            conversation starts at the real problem, not at zero.
          </p>
          <div class="quiz-fields">
            <div class="quiz-field">
              <label for="q-name">Name</label>
              <input id="q-name" name="name" type="text" autocomplete="name" required />
              <p class="quiz-field__error" data-error-for="q-name">Please enter your name.</p>
            </div>
            <div class="quiz-field">
              <label for="q-email">Business email</label>
              <input id="q-email" name="email" type="email" autocomplete="email" required />
              <p class="quiz-field__error" data-error-for="q-email">Please enter a valid email address.</p>
            </div>
            <div class="quiz-field">
              <label for="q-company">Company</label>
              <input id="q-company" name="company" type="text" autocomplete="organization" required />
              <p class="quiz-field__error" data-error-for="q-company">Please enter your company name.</p>
            </div>
            <div class="quiz-field">
              <label for="q-website">Website</label>
              <input id="q-website" name="website" type="text" inputmode="url" autocomplete="url" placeholder="yourcompany.com" required />
              <p class="quiz-field__error" data-error-for="q-website">Please enter your website.</p>
            </div>
            <div class="quiz-field">
              <label for="q-phone">Phone <span>(optional)</span></label>
              <input id="q-phone" name="phone" type="tel" autocomplete="tel" />
            </div>
            <div class="quiz-field quiz-field--full">
              <label for="q-notes">Anything important we should know? <span>(optional)</span></label>
              <textarea id="q-notes" name="notes" rows="3"></textarea>
            </div>
          </div>
        </section>

        <section class="quiz-step" data-step="11" data-finish>
          <p class="quiz-finish__kicker">Answers received</p>
          <h2 class="quiz-step__question">Pick a time. We&rsquo;ll bring the plan.</h2>
          <p class="quiz-step__hint">
            30 minutes, free, no deck, no obligation. Prefer to talk now?
            Call <a href="tel:+12407304333">240-730-4333</a>.
          </p>
          <div class="quiz-finish__calendly" data-calendly></div>
        </section>

        <div class="quiz-controls">
          <button class="quiz-back" type="button" data-back hidden>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            Back
          </button>
          <button class="btn btn--primary quiz-submit" type="submit" data-submit hidden>
            See available times
          </button>
        </div>

      </form>
    </div>
  </main>

  <footer class="quiz-footer">
    <div class="container quiz-footer__inner">
      <p>&copy; 2026 Aivium Digital</p>
      <p><a href="tel:+12407304333">240-730-4333</a></p>
    </div>
  </footer>

  <Fragment slot="scripts">
    <script is:inline src="/js/quiz.js"></script>
  </Fragment>
</BaseLayout>
