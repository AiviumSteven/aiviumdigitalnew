---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Aivium Digital | Page Not Found"
  description="This page doesn't exist, or it moved to a new orbit."
  canonical="/404"
  noindex={true}
>
  <Fragment slot="head">
    <style is:inline>
      .notfound {
        min-height: 100vh;
        display: grid;
        place-items: center;
        text-align: center;
        padding: var(--space-8, 2rem);
      }
      .notfound__code {
        font-family: var(--font-mono, monospace);
        color: var(--accent, #e5391b);
        margin-bottom: 1rem;
      }
      .notfound h1 { margin-bottom: 1rem; }
      .notfound p { margin-bottom: 2rem; }
      .notfound__links {
        list-style: none;
        margin: 2rem 0 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem 1.5rem;
        font-family: var(--font-mono, monospace);
        font-size: 0.8125rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .notfound__links a {
        color: var(--cream-72, #ccc);
        text-decoration: underline;
        text-underline-offset: 4px;
      }
      .notfound__links a:hover { color: var(--cream, #fff); }
    </style>
  </Fragment>

  <main class="notfound">
    <div>
      <p class="notfound__code">404</p>
      <h1>Lost in space.</h1>
      <p class="lede">This page doesn&rsquo;t exist, or it moved to a new orbit.</p>
      <a class="btn btn--primary" href="/">Back to the homepage</a>
      <ul class="notfound__links" aria-label="Popular destinations">
        <li><a href="/services/">Services</a></li>
        <li><a href="/ai-seo/">AI Visibility</a></li>
        <li><a href="/ai-automation/">AI Solutions</a></li>
        <li><a href="/signals/">Signals</a></li>
        <li><a href="/discovery/">Book a discovery call</a></li>
      </ul>
    </div>
  </main>
</BaseLayout>
