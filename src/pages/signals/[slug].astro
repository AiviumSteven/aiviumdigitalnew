---
import { render } from "astro:content";
import { Image, getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getSignals, type SignalEntry } from "../../lib/signals";
import { getAuthor } from "../../data/authors";

export async function getStaticPaths() {
  return (await getSignals()).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: SignalEntry;
}

const { entry } = Astro.props;
const site = "https://aiviumdigital.com";

const title = entry.data.title;
const excerpt = entry.data.excerpt;
const publishedAt = entry.data.publishedAt.toISOString();
const updatedAt = entry.data.updatedAt?.toISOString() ?? null;
const slug = entry.id;
const author = getAuthor(entry.data.author);

const { Content } = await render(entry);

// Optional hero: rendered above the body and reused as this post's
// og:image + JSON-LD image (sitewide og-image.jpg is the fallback).
const heroOg = entry.data.image
  ? await getImage({ src: entry.data.image, width: 1200 })
  : null;
const ogImage = heroOg?.src ?? "/assets/og-image.jpg";

const authorImg = author.image ? await getImage({ src: author.image, width: 800 }) : null;
const authorUrl = author.page ? `${site}${author.page}` : `${site}/`;
const faq = entry.data.faq;

const description = excerpt ?? `${title} — a signal from Aivium Digital.`;

const fmtDate = (iso: string | null) =>
  iso
    ? new Date(iso).toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
        timeZone: "UTC",
      })
    : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      headline: title,
      description,
      url: `${site}/signals/${slug}/`,
      mainEntityOfPage: `${site}/signals/${slug}/`,
      image: new URL(ogImage, site).href,
      datePublished: publishedAt,
      ...(updatedAt ? { dateModified: updatedAt } : {}),
      author: { "@id": `${site}/#${author.id}` },
      publisher: { "@id": `${site}/#org` },
      isPartOf: { "@id": `${site}/signals/#blog` },
    },
    {
      "@type": "Person",
      "@id": `${site}/#${author.id}`,
      name: author.name,
      jobTitle: author.role,
      description: author.bio,
      worksFor: { "@id": `${site}/#org` },
      url: authorUrl,
      ...(authorImg ? { image: new URL(authorImg.src, site).href } : {}),
      ...(author.sameAs.length ? { sameAs: author.sameAs } : {}),
    },
    {
      "@type": "Organization",
      "@id": `${site}/#org`,
      name: "Aivium Digital",
      url: `${site}/`,
      logo: `${site}/assets/aivium-digital-lockup-horizontal-dark.svg`,
      sameAs: ["https://aivium.com/", "https://www.linkedin.com/company/aiviumdigital/"],
      parentOrganization: {
        "@type": "Organization",
        "@id": "https://aivium.com/#organization",
        name: "Aivium",
        url: "https://aivium.com/",
      },
    },
    ...(faq.length > 0
      ? [
          {
            "@type": "FAQPage",
            "@id": `${site}/signals/${slug}/#faq`,
            mainEntity: faq.map((f) => ({
              "@type": "Question",
              name: f.q,
              acceptedAnswer: { "@type": "Answer", text: f.a },
            })),
          },
        ]
      : []),
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Signals", item: `${site}/signals/` },
        { "@type": "ListItem", position: 3, name: title, item: `${site}/signals/${slug}/` },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${title} | Aivium Digital Signals`}
  description={description}
  canonical={`/signals/${slug}/`}
  ogImage={ogImage}
  article={{ publishedTime: publishedAt, modifiedTime: updatedAt }}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <SiteNav active="signals" />

  <main>
    <article class="note">
      <div class="container note__container">
        <a href="/signals/" class="note__back">← All signals</a>
        <h1 class="note__title">{title}</h1>
        <div class="note__byline">
          {
            author.image ? (
              <Image src={author.image} alt={author.name} width={44} height={44} class="note__avatar" />
            ) : (
              <span class="note__avatar note__avatar--monogram" aria-hidden="true">{author.initials}</span>
            )
          }
          <div>
            <p class="note__author">
              By {author.page ? <a href={author.page} class="note__author-link">{author.name}</a> : author.name}{" "}
              <span class="note__author-role">· {author.role}</span>
            </p>
            <p class="note__date">
              <time datetime={publishedAt}>{fmtDate(publishedAt)}</time>
              {updatedAt && (
                <>
                  {" · Updated "}
                  <time datetime={updatedAt}>{fmtDate(updatedAt)}</time>
                </>
              )}
            </p>
          </div>
        </div>
        {
          excerpt && (
            <p class="note__lede">{excerpt}</p>
          )
        }
        {
          entry.data.image && (
            <Image
              src={entry.data.image}
              alt={entry.data.imageAlt ?? ""}
              widths={[640, 960, 1280]}
              sizes="(max-width: 768px) 100vw, 736px"
              class="note__hero"
            />
          )
        }
        <div class="note__body">
          <Content />
        </div>

        {
          faq.length > 0 && (
            <section class="note__faq" aria-labelledby="post-faq-heading">
              <h2 id="post-faq-heading" class="note__faq-heading">Questions, answered.</h2>
              <div class="note__faq-list">
                {faq.map((f, i) => (
                  <details class="note__faq-item" open={i === 0}>
                    <summary>{f.q}</summary>
                    <p>{f.a}</p>
                  </details>
                ))}
              </div>
            </section>
          )
        }

        <aside class="note__bio" aria-label="About the author">
          {
            author.image ? (
              <Image src={author.image} alt={author.name} width={64} height={64} class="note__bio-avatar" />
            ) : (
              <span class="note__bio-avatar note__avatar--monogram" aria-hidden="true">{author.initials}</span>
            )
          }
          <div>
            <p class="note__bio-label">About the author</p>
            <p class="note__bio-name">
              {author.page ? <a href={author.page} class="note__author-link">{author.name}</a> : author.name}{" "}
              <span class="note__author-role">· {author.role}</span>
            </p>
            <p class="note__bio-text">{author.bio}</p>
            {author.sameAs.length > 0 && (
              <p class="note__bio-links">
                {author.page && <a href={author.page}>More about {author.name.split(" ")[0]} →</a>}
                <a href={author.sameAs[0]} target="_blank" rel="noopener">LinkedIn ↗</a>
              </p>
            )}
          </div>
        </aside>
      </div>
    </article>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .note {
    padding: calc(var(--space-24) + var(--space-12)) 0 var(--space-section);
  }
  .note__container {
    max-width: 50rem;
  }
  .note__back {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--cream-55);
    text-decoration: none;
  }
  .note__back:hover {
    color: var(--cream);
  }
  .note__title {
    margin: var(--space-6) 0 0;
    font-size: var(--text-h2);
    font-family: var(--font-display);
    font-stretch: var(--stretch-display);
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
    color: var(--cream);
  }
  .note__byline {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .note__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    flex-shrink: 0;
    object-fit: cover;
  }
  .note__avatar--monogram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--void-850);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    color: var(--cream-55);
  }
  .note__author {
    margin: 0;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--cream);
  }
  .note__author-role {
    font-weight: 400;
    color: var(--cream-55);
  }
  .note__date {
    margin: var(--space-1) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--cream-55);
  }
  .note__bio {
    display: flex;
    gap: var(--space-6);
    align-items: flex-start;
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--line);
  }
  .note__bio-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    flex-shrink: 0;
    object-fit: cover;
  }
  .note__bio-avatar.note__avatar--monogram {
    font-size: 1.25rem;
  }
  .note__bio-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .note__bio-name {
    margin: var(--space-2) 0 0;
    font-weight: 600;
    color: var(--cream);
  }
  .note__bio-text {
    margin: var(--space-3) 0 0;
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--cream-72);
  }
  .note__author-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--line-strong);
  }
  .note__author-link:hover {
    color: var(--accent);
  }
  .note__bio-links {
    margin: var(--space-4) 0 0;
    display: flex;
    gap: var(--space-6);
  }
  .note__bio-links a {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--cream-55);
    text-decoration: none;
  }
  .note__bio-links a:hover {
    color: var(--cream);
  }
  .note__faq {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--line);
  }
  .note__faq-heading {
    margin: 0;
    font-size: var(--text-h3);
    color: var(--cream);
  }
  .note__faq-list {
    margin-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .note__faq-item {
    border-bottom: 1px solid var(--line);
  }
  .note__faq-item summary {
    padding: var(--space-4) 0;
    cursor: pointer;
    font-weight: 600;
    color: var(--cream);
    list-style: none;
  }
  .note__faq-item summary::-webkit-details-marker {
    display: none;
  }
  .note__faq-item summary::before {
    content: "+ ";
    color: var(--accent);
    font-family: var(--font-mono);
  }
  .note__faq-item[open] summary::before {
    content: "− ";
  }
  .note__faq-item p {
    margin: 0;
    padding: 0 0 var(--space-4) var(--space-6);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--cream-72);
  }
  .note__lede {
    margin: var(--space-6) 0 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--accent);
    font-size: 1.1875rem;
    line-height: var(--leading-body);
    color: var(--cream-72);
  }
  .note__hero {
    margin-top: var(--space-8);
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }

  /* Article body typography — content arrives via <Content />, so style
     its children through :global(). */
  .note__body {
    margin-top: var(--space-8);
  }
  .note__body :global(p) {
    margin: 1.1em 0 0;
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--cream-72);
  }
  .note__body :global(h2) {
    margin: 2.2em 0 0;
    font-size: var(--text-h3);
    color: var(--cream);
  }
  .note__body :global(h3) {
    margin: 1.8em 0 0;
    font-size: 1.125rem;
    color: var(--cream);
  }
  .note__body :global(ul),
  .note__body :global(ol) {
    margin: 1.1em 0 0;
    padding-left: 1.4em;
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--cream-72);
  }
  .note__body :global(li) {
    margin-top: 0.45em;
  }
  .note__body :global(strong) {
    color: var(--cream);
  }
  .note__body :global(a) {
    color: var(--cream);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .note__body :global(a:hover) {
    color: var(--accent);
  }
  .note__body :global(blockquote) {
    margin: 1.4em 0 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--line-strong);
    color: var(--cream-72);
  }
  .note__body :global(img) {
    margin-top: 1.6em;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }
  .note__body :global(pre) {
    margin: 1.4em 0 0;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    border: 1px solid var(--line);
    background: var(--void-850);
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  .note__body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
  }
  .note__body :global(table) {
    margin: 1.6em 0 0;
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-small);
  }
  .note__body :global(th),
  .note__body :global(td) {
    padding: 0.6rem 0.9rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .note__body :global(th) {
    color: var(--cream);
  }
  .note__body :global(td) {
    color: var(--cream-72);
  }
  .note__body :global(hr) {
    margin: 2.5em 0 0;
    border: none;
    border-top: 1px solid var(--line);
  }
</style>
