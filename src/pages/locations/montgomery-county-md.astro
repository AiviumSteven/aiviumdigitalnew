---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { orgNode, webPageNode, breadcrumbNode, graph } from "../../lib/schema";
import { COMPANY } from "../../data/company";

const trail: [string, string][] = [
  ["Home", "/"],
  ["Maryland", "/locations/maryland/"],
  ["Montgomery County, MD", "/locations/montgomery-county-md/"],
];

const description =
  "Aivium Digital helps Montgomery County businesses, from Rockville and Bethesda to Gaithersburg and Silver Spring, get cited in AI search and build custom AI agents and automations.";

const faq = [
  {
    q: "Which parts of Montgomery County do you serve?",
    a: "All of it. Rockville, Bethesda, Gaithersburg, Silver Spring, Germantown, Potomac, Chevy Chase, and the towns between. Audits, builds, and reporting run remotely, and because we are a Maryland company, in-person working sessions are on the table when they genuinely help.",
  },
  {
    q: "We already rank well on Google. Why does AI visibility matter?",
    a: "Rankings and citations are different achievements. A page can sit at position three on Google while ChatGPT, Gemini, and Google AI Overviews recommend three competitors by name. Montgomery County's buyers adopted AI tools early, so the gap between ranking and being recommended costs more here than in most markets. The audit measures that gap before you spend anything on fixing it.",
  },
  {
    q: "How are you different from the DC agencies pitching us?",
    a: "Scope and accountability. We are a Maryland company, founder-led, and every engagement is fixed-scope with the deliverables documented and owned by you. And we build past visibility: the same engagement can wire AI agents and automations into your intake and operations, which most visibility-only agencies never touch.",
  },
];

const jsonLd = graph(
  webPageNode(
    "/locations/montgomery-county-md/",
    "AI Consulting, AI SEO & Automation in Montgomery County, MD",
    description,
  ),
  breadcrumbNode(trail),
  orgNode(),
  {
    "@type": "FAQPage",
    "@id": `${COMPANY.url}/locations/montgomery-county-md/#faq`,
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
);
---

<BaseLayout
  title="Aivium Digital | AI Consulting in Montgomery County, MD"
  description={description}
  ogDescription="AI-search visibility and custom AI automation for Montgomery County businesses, from Rockville and Bethesda to Gaithersburg and Silver Spring."
  canonical="/locations/montgomery-county-md/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <SiteNav />

  <main>
    <section class="page-hero">
      <div class="container">
        <div class="page-hero__content">
          <Breadcrumbs trail={trail} />
          <hgroup class="hero__title">
            <h1 class="hero__eyebrow">AI visibility and AI automation for Montgomery County businesses, from Rockville to Bethesda.</h1>
            <p class="hero__headline">Careful buyers.<br />Cited&nbsp;answers.</p>
          </hgroup>
          <p class="lede">
            Aivium Digital is a Maryland AI visibility and AI automation
            company serving Montgomery County businesses across Rockville,
            Bethesda, Gaithersburg, Silver Spring, and the towns between.
            We make established firms easier to find, understand, and
            recommend when buyers ask Google or an AI assistant who to
            trust, and we build the AI systems that put the resulting
            demand to work.
          </p>
          <div class="page-hero__actions">
            <a class="btn btn--primary" href="/discovery/">Book a discovery call</a>
            <a class="btn btn--ghost" href="#market">Why this county</a>
          </div>
        </div>
      </div>
    </section>

    <section class="pagesec" id="market">
      <div class="container defblock">
        <h2>The most research-heavy market in Maryland</h2>
        <div class="defblock__body">
          <p class="defblock__big">
            Montgomery County buyers do their homework. Before anyone
            calls you, they have asked Google, and increasingly an AI
            assistant, who is worth calling.
          </p>
          <p>
            This is one of the most educated counties in America. NIH in
            Bethesda, FDA in Silver Spring, NIST in Gaithersburg, and the
            biotech corridor along I-270 fill the county with people who
            research for a living, and they buy the way they work:
            compare, verify, then commit. When those buyers ask ChatGPT,
            Claude, Gemini, Perplexity, Copilot, or Google AI Overviews
            who to hire, the engines answer with a shortlist. Either your
            business is on it, described accurately and backed by signals
            the engines trust, or the conversation ends before you knew
            it started.
          </p>
          <p>
            The county is also thick with agencies, most still selling
            the rankings they sold five years ago. The bar has moved:
            being findable is table stakes, and being the verified,
            cited answer is the game. We build for the new bar, from
            inside the same state, as a founder-led partner rather than
            a rotating account team.
          </p>
        </div>
      </div>
    </section>

    <section class="pagesec" id="fits">
      <div class="container">
        <div class="pagesec__head">
          <h2>Who this fits in Montgomery County</h2>
          <p class="lede">
            Businesses whose buyers verify before they call.
          </p>
        </div>
        <div class="dgrid">
          <div class="dgrid__cell">
            <h3>Professional firms</h3>
            <p>
              Law, accounting, and advisory practices in Bethesda and
              Rockville live on referrals. Referrals now get verified:
              the client hears your name, asks an engine about you, and
              what it says decides whether the call happens.
            </p>
          </div>
          <div class="dgrid__cell">
            <h3>Health and specialty practices</h3>
            <p>
              Patients here research providers like analysts. If the
              engines describe your practice vaguely, or describe your
              competitors better, the appointment goes elsewhere.
            </p>
          </div>
          <div class="dgrid__cell">
            <h3>Home services</h3>
            <p>
              Homeowners from Potomac to Chevy Chase vet contractors
              thoroughly and pay well for the ones who pass. Reviews,
              consistent profiles, and real service-area content decide
              who gets vetted at all. Our deepest vertical is
              <a href="/industries/home-services/">home services</a>.
            </p>
          </div>
          <div class="dgrid__cell">
            <h3>Consultancies and B2B</h3>
            <p>
              The I-270 corridor is dense with firms selling expertise.
              When a buyer asks an AI engine who does what you do, the
              answer is assembled from whoever published the clearest
              evidence.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="pagesec" id="system">
      <div class="container defblock">
        <h2>One engagement, both layers</h2>
        <div class="defblock__body">
          <p class="defblock__big">
            The signals that convince a careful buyer are the signals
            that convince an engine: consistent identity, real reviews,
            and content that answers what buyers actually ask.
          </p>
          <p>
            Our <a href="/ai-seo/">visibility system</a> builds those
            foundations once, and every engine that reads them gets the
            same story. The <a href="/ai-automation/">automation
            layer</a> then puts AI to work inside the business: intake,
            follow-up, and reporting, the hours your team loses to
            handoffs. Every engagement opens with the
            <a href="/ai-visibility-audit/">AI Visibility Audit</a>,
            which shows what the engines currently say about you and who
            they name instead.
          </p>
        </div>
      </div>
      <div class="container">
        <div class="xlink">
          <div class="xlink__copy">
            <h3>Statewide, one partner.</h3>
            <p>
              Montgomery County is one of the Maryland markets we serve
              from Hagerstown, with
              <a href="/about-steven/">Steven Mills</a> hands-on in every
              engagement.
            </p>
          </div>
          <a class="btn btn--ghost" href="/locations/maryland/">Our Maryland page</a>
        </div>
      </div>
    </section>

    <section class="faq pagesec" id="faq">
      <div class="container faq__inner">
        <div class="faq__head">
          <h2>Montgomery County questions, answered.</h2>
          <p class="lede faq__lede">What businesses here ask us first.</p>
        </div>
        <div class="faq__list">
          {
            faq.map((f) => (
              <details class="faq__item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cta" id="contact">
      <div class="container cta__inner">
        <div class="cta__content">
          <h2 class="cta__heading">
            <span class="cta__question">Want to know what AI tells the county&rsquo;s most careful buyers about you?</span>
            Let&rsquo;s find out.
          </h2>
          <a class="btn btn--primary cta__btn" href="/discovery/">Book a discovery call</a>
          <ul class="cta__checklist" aria-label="What the audit involves">
            <li>30 minutes</li>
            <li>Free</li>
            <li>No deck</li>
            <li>No obligation</li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
