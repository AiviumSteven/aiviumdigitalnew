---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout
  title="Aivium Digital | AI Automation Agency & Custom AI Solutions"
  description="Aivium Digital is an AI automation agency for established businesses, from local operators to enterprise: custom AI agents, assistants, and automations built on your own data."
  ogDescription="Custom AI agents, assistants, and automations for established businesses, built on your own data. Book a free AI audit."
  canonical="/ai-automation/"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline>
    {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "name": "AI Automation & Custom AI Solutions",
        "serviceType": "AI automation, custom AI agents, AI assistants, generative AI consulting, AI integration services",
        "provider": { "@id": "https://aiviumdigital.com/#org" },
        "areaServed": "US",
        "description": "Custom AI agents, assistants, and workflow automations for established businesses, from local operators to enterprise, built on the client's own data."
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://aiviumdigital.com/" },
          { "@type": "ListItem", "position": 2, "name": "AI Automation Agency", "item": "https://aiviumdigital.com/ai-automation/" }
        ]
      }
    ]
  }
    </script>
  </Fragment>

  <SiteNav active="solutions" />

  <main>
    <section class="page-hero">
      <div class="container">
        <div class="page-hero__content">
          <hgroup class="hero__title">
            <h1 class="hero__eyebrow">AI automation agency for growing businesses</h1>
            <p class="hero__headline">Put AI to work<br />inside your&nbsp;business.</p>
          </hgroup>
          <p class="lede">
            Aivium Digital builds custom AI solutions for established
            businesses, from local operators to enterprise: agents,
            assistants, and automations designed around how you actually
            operate, scoped so you know exactly what you're getting.
          </p>
          <div class="page-hero__actions">
            <a class="btn btn--primary" href="/discovery/">Book a free AI audit</a>
            <a class="btn btn--ghost" href="#process">See how it runs</a>
          </div>
        </div>
      </div>
    </section>

    <div class="band" aria-hidden="true">
      <img src="/assets/pages/automation-hero.webp" alt="" loading="lazy" />
    </div>

    <nav class="jumpnav" aria-label="On this page">
      <div class="container jumpnav__inner">
        <a href="#what-we-build">What we build</a>
        <a href="#smb">Who it's for</a>
        <a href="#process">How it runs</a>
        <a href="#faq">FAQ</a>
      </div>
    </nav>

    <section class="pagesec" id="what-we-build">
      <div class="container defblock">
        <h2>What an AI automation agency builds</h2>
        <div class="defblock__body">
          <p class="defblock__big">
            An AI automation agency designs and builds the AI systems a
            business runs on: agents that handle work, assistants that
            answer from your data, and automations that connect the tools
            you already use.
          </p>
          <p>
            Our generative AI consulting starts with your operations, not
            with the technology. We find where hours leak (quoting,
            scheduling, follow-up, reporting), then build the smallest
            system that stops the leak. You own everything we ship.
          </p>
        </div>
      </div>
      <div class="container">
        <div class="dgrid">
          <div class="dgrid__cell">
            <h3>AI agents</h3>
            <p>
              Software that does a job start to finish: qualifying leads,
              chasing invoices, triaging inboxes. Agents work your queue so
              your team works the exceptions.
            </p>
          </div>
          <div class="dgrid__cell">
            <h3>AI assistants</h3>
            <p>
              Chat and voice assistants trained on your own data: your
              services, prices, policies, and history. Customers get instant
              answers; staff get a second brain.
            </p>
          </div>
          <div class="dgrid__cell">
            <h3>Workflow automations</h3>
            <p>
              The busywork between systems, automated: intake to CRM, quote
              to invoice, job complete to review request. Hours back every
              week, without changing the tools you use.
            </p>
          </div>
          <div class="dgrid__cell">
            <h3>AI integration services</h3>
            <p>
              AI wired into the software you already run: your CRM, your
              field software, your books. No rip-and-replace, no new logins
              for the team to ignore.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="pagesec" id="smb">
      <div class="container defblock">
        <h2>AI consulting for established businesses</h2>
        <div class="defblock__body">
          <p class="defblock__big">
            Whether you run a local operation or an enterprise team, you
            don't need a year-long transformation program. You need the
            automations that pay for themselves this quarter, built in
            weeks, not quarters.
          </p>
          <p>
            That's the engagement we've built for established businesses at
            every scale: fixed-scope projects, plain-language training for
            your team, and systems that keep running whether or not you keep
            paying us. AI automation only works if it outlives the
            consultant.
          </p>
        </div>
      </div>
    </section>

    <section class="pagesec" id="process">
      <div class="container">
        <div class="pagesec__head">
          <h2>How an engagement runs</h2>
          <p class="lede">
            Four steps from first call to running system. No phase lasts
            longer than it earns.
          </p>
        </div>
        <div class="steps">
          <div class="step">
            <p class="step__num">01</p>
            <div class="step__body">
              <h3>Opportunity map</h3>
              <p>
                We audit your operations and rank every automation candidate
                by hours saved and payback speed. You get the map whether or
                not we build together.
              </p>
            </div>
          </div>
          <div class="step">
            <p class="step__num">02</p>
            <div class="step__body">
              <h3>Pilot build</h3>
              <p>
                The highest-payback item ships first, in weeks. Real work,
                measured against the baseline, so the decision to continue
                is made on evidence.
              </p>
            </div>
          </div>
          <div class="step">
            <p class="step__num">03</p>
            <div class="step__body">
              <h3>Deploy &amp; train</h3>
              <p>
                We wire it into your stack, train your team in their own
                vocabulary, and document everything. Adoption is the
                deliverable, not the software.
              </p>
            </div>
          </div>
          <div class="step">
            <p class="step__num">04</p>
            <div class="step__body">
              <h3>Monitor &amp; expand</h3>
              <p>
                We watch performance, fix drift, and work down the
                opportunity map. Each automation pays for the next one.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pagesec" id="engagement">
      <div class="container">
        <div class="pagesec__head">
          <h2>Know the plan before we build</h2>
          <p class="lede">
            Every engagement starts with the audit: a review that ends in a
            ranked automation map and a clear scope of work. If we don't
            think an automation pays for itself, we'll tell you not to
            build it.
          </p>
        </div>

        <div class="xlink">
          <div class="xlink__copy">
            <h3>First, be found.</h3>
            <p>
              Automation multiplies demand you already have. Our GEO service
              makes sure AI search keeps sending it.
            </p>
          </div>
          <a class="btn btn--ghost" href="/ai-seo/">Explore GEO services</a>
        </div>
      </div>
    </section>

    <section class="faq pagesec" id="faq">
      <div class="container faq__inner">
        <div class="faq__head">
          <h2>Automation, explained.</h2>
          <p class="lede faq__lede">
            What owners ask us before they start.
          </p>
        </div>

        <div class="faq__list">
          <details class="faq__item">
            <summary>What does an AI automation agency do?</summary>
            <p>
              An AI automation agency finds the work inside a business that
              software can do reliably, then builds and maintains the AI
              systems that do it: agents, assistants, and workflow
              automations connected to the tools you already run.
            </p>
          </details>
          <details class="faq__item">
            <summary>What should we automate first?</summary>
            <p>
              The work that is high-volume, rule-shaped, and hated: lead
              follow-up, scheduling, data entry between systems, reporting.
              The audit ranks your list by payback so the first build funds
              the second.
            </p>
          </details>
          <details class="faq__item">
            <summary>Do we need our own developers?</summary>
            <p>
              No. We build, deploy, and maintain everything, and we train
              your team to run it day to day. If you have developers, we
              hand off cleanly; everything we ship is documented and yours.
            </p>
          </details>
          <details class="faq__item">
            <summary>Which AI models and tools do you build on?</summary>
            <p>
              Whatever fits the job: the major model providers plus the
              automation platforms your stack already touches. We're vendor-neutral, and we design so you can swap
              models later without rebuilding.
            </p>
          </details>
        </div>
      </div>

      <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What does an AI automation agency do?",
            "acceptedAnswer": { "@type": "Answer", "text": "An AI automation agency finds the work inside a business that software can do reliably, then builds and maintains the AI systems that do it: agents, assistants, and workflow automations connected to the tools you already run." }
          },
          {
            "@type": "Question",
            "name": "What should we automate first?",
            "acceptedAnswer": { "@type": "Answer", "text": "The work that is high-volume, rule-shaped, and hated: lead follow-up, scheduling, data entry between systems, and reporting. An audit ranks the list by payback so the first build funds the second." }
          },
          {
            "@type": "Question",
            "name": "Do we need our own developers?",
            "acceptedAnswer": { "@type": "Answer", "text": "No. Aivium Digital builds, deploys, and maintains everything, and trains your team to run it day to day. Everything shipped is documented and owned by the client." }
          },
          {
            "@type": "Question",
            "name": "Which AI models and tools do you build on?",
            "acceptedAnswer": { "@type": "Answer", "text": "Whatever fits the job: the major model providers plus the automation platforms your stack already touches. Aivium Digital is vendor-neutral and designs so models can be swapped later without rebuilding." }
          }
        ]
      }
      </script>
    </section>

    <section class="cta" id="contact">
      <div class="container cta__inner">
        <div class="cta__content">
          <h2 class="cta__heading">
            <span class="cta__question">Wondering what AI could take off your plate?</span>
            The audit will tell you.
          </h2>
          <a class="btn btn--primary cta__btn" href="/discovery/">Book a free AI audit</a>
          <ul class="cta__checklist" aria-label="What the audit involves">
            <li>30 minutes</li>
            <li>Free</li>
            <li>No deck</li>
            <li>No obligation</li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />

  <Fragment slot="scripts">
  </Fragment>
</BaseLayout>
